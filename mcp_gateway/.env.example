# Read-only GitHub token is strongly recommended for reliable code search.
# Use a fine-grained token; do not commit the real value.
GITHUB_TOKEN=

JANUS_GITHUB_OWNER=Hawkar-usls
JANUS_REGISTRY_REPO=Hawkar-usls/janus-meta-registry
JANUS_TOPA_REPO=Hawkar-usls/TOPA
JANUS_COSMOS_REPO=Hawkar-usls/Janus-Cosmos
JANUS_CHECKPOINT_REPO=Hawkar-usls/Janus

# Write tools are OFF by default.
JANUS_ALLOW_WRITES=0
JANUS_WRITE_BRANCH=mcp-checkpoints

MCP_HOST=0.0.0.0
MCP_PORT=8000
JANUS_MAX_TEXT_BYTES=120000
