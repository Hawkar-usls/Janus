{
  "schema": "janus.link.v1",
  "id": "JANUS_MCP_GATEWAY_V0_2_ORGANISM",
  "status": "ACTIVE_PROTOTYPE",
  "path": "mcp_gateway/",
  "endpoint_path": "/mcp",
  "transport": "streamable-http",
  "organism_id": "JANUS_FEDERATED_ORGANISM",
  "organism_manifest": "organism/JANUS_ORGANISM_v1.json",
  "default_mode": "READ_ONLY",
  "write_gate": "JANUS_ALLOW_WRITES=1",
  "write_branch_default": "mcp-checkpoints",
  "bound_repositories": [
    "Hawkar-usls/Janus",
    "Hawkar-usls/janus-meta-registry",
    "Hawkar-usls/Janus-Fundamentum",
    "Hawkar-usls/Demi_Head",
    "Hawkar-usls/Janus-Demiurge",
    "Hawkar-usls/janus-distributed-ai-swarm",
    "Hawkar-usls/janus-lapis",
    "Hawkar-usls/aura-oracle-tg",
    "Hawkar-usls/TOPA",
    "Hawkar-usls/Janus-Cosmos"
  ],
  "organism_tools": [
    "janus.organism_map",
    "janus.search_organ",
    "janus.read_organ"
  ],
  "writes_to_member_repositories": false,
  "claim_boundary": [
    "ORGANISM_MEMBERSHIP != AUTHORITY_INHERITANCE",
    "SEARCH_MATCH != VALIDATED_CLAIM",
    "SYMBOLIC_OUTPUT != EMPIRICAL_EVIDENCE",
    "RANKING != VALIDATION",
    "DISPATCH != AUTHORITY",
    "ARTIFACT != INDEPENDENT_REPLICATION"
  ]
}
