  },
  "ecology_flow": [
    "TOOLCHAIN_DEPENDENCY -> ORGAN_OR_SUBTISSUE",
    "PRIVATE_SUBTISSUE -> PARENT_ORGAN",
    "SUBTISSUE -> PARENT_ORGAN",
    "LEGACY_ARCHIVE -> MEMORY_FOR_LINEAGE_ONLY",
    "EXTERNAL_RESEARCH_INSTRUMENT -> ORGAN_WITH_PROVENANCE_PRESERVED",
    "PARENT_ORGAN -> SPIRAL_EXECUTION_CONSTITUTION"
  ],
  "admission_rule": "A repository can belong to JANUS ecology without becoming an organ. Promotion to ORGAN requires a distinct function, typed inputs/outputs, explicit authority boundary, and a reason not already represented by an existing organ.",
  "next_review": "Re-audit owner repositories whenever a new repository appears or an existing legacy/dependency repository acquires a distinct active JANUS-native function."
}
