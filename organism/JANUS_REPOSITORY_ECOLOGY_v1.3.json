    "arduino_ai_chat_library": {"repo": "Hawkar-usls/Arduino-AI-Chat-Library", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "arduino_ide": {"repo": "Hawkar-usls/arduino-ide", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "cardputer_game_station": {"repo": "Hawkar-usls/Cardputer-Game-Station-Emulators", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "clawdbot": {"repo": "Hawkar-usls/clawdbot", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "emoji": {"repo": "Hawkar-usls/emoji", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "esp32_twai_can": {"repo": "Hawkar-usls/ESP32-TWAI-CAN", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "m5unit_env": {"repo": "Hawkar-usls/M5Unit-ENV", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "player": {"repo": "Hawkar-usls/player", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "radio_player_v3": {"repo": "Hawkar-usls/RadioPlayerV3", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "tranception_ml": {"repo": "Hawkar-usls/tranception", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false, "boundary": "UPSTREAM_ML_REPOSITORY != JANUS_TRANCEPTION_OPERATOR"},
    "vcmi": {"repo": "Hawkar-usls/vcmi", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false},
    "xiaozhi_esp32": {"repo": "Hawkar-usls/xiaozhi-esp32", "class": "TOOLCHAIN_DEPENDENCY", "base_authorship_claimed": false}
