    },
    "sslot": {
      "repo": "Hawkar-usls/SSlot",
      "class": "LEGACY_ARCHIVE",
      "former_scope": "APPLICATION_OR_GAME_PROTOTYPE",
      "boundary": "LEGACY_APPLICATION != ACTIVE_RESEARCH_CAPABILITY"
    }
  },
