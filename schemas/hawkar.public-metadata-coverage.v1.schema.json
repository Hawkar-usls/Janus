{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hawkar-usls/Janus/blob/main/schemas/hawkar.public-metadata-coverage.v1.schema.json",
  "title": "Hawkar Public Metadata Coverage v1",
  "description": "Schema for the account-wide public metadata coverage audit and profile-surface identity binding.",
  "type": "object",
  "required": [
    "schema_id",
    "audit_id",
    "last_reviewed",
    "owner",
    "public_repository_count",
    "profile_surface",
    "portfolio_index_coverage",
    "project_status_coverage",
    "schemas",
    "interpretation"
  ],
  "properties": {
    "schema_id": {
      "const": "hawkar.public-metadata-coverage.v1"
    },
    "audit_id": {
      "const": "hawkar.public-metadata-coverage.v1"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "public_repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "profile_surface": {
      "type": "object",
      "required": [
        "repository",
        "repository_url",
        "readme_url",
        "canonical_source_url",
        "profile_readme_commit",
        "canonical_source_commit",
        "git_blob_sha1",
        "content_identity",
        "role",
        "evidence_bearing_project"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "repository_url": {"type": "string", "format": "uri"},
        "readme_url": {"type": "string", "format": "uri"},
        "canonical_source_url": {"type": "string", "format": "uri"},
        "profile_readme_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "canonical_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_blob_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "content_identity": {"enum": ["MATCH", "MISMATCH", "NOT_CHECKED"]},
        "role": {"type": "string", "minLength": 1},
        "evidence_bearing_project": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "portfolio_index_coverage": {
      "type": "object",
      "required": [
        "classified_project_repositories",
        "profile_metadata_surfaces",
        "total_public_repositories",
        "unclassified_project_repositories",
        "note"
      ],
      "properties": {
        "classified_project_repositories": {"type": "integer", "minimum": 0},
        "profile_metadata_surfaces": {"type": "integer", "minimum": 0},
        "total_public_repositories": {"type": "integer", "minimum": 0},
        "unclassified_project_repositories": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "project_status_coverage": {
      "type": "object",
      "required": [
        "with_PROJECT_STATUS_json",
        "total_public_repositories",
        "intentional_exceptions",
        "unexplained_missing"
      ],
      "properties": {
        "with_PROJECT_STATUS_json": {"type": "integer", "minimum": 0},
        "total_public_repositories": {"type": "integer", "minimum": 0},
        "intentional_exceptions": {
          "type": "array",
          "items": {"type": "object"}
        },
        "unexplained_missing": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "interpretation": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
